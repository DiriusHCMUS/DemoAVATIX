# ─── AVA-TIX Environment Variables ────────────────────────────────────────────
# Sao chép file này thành .env và điền giá trị thực

# App
SECRET=avatix-dev-secret-doi-khi-deploy
PORT=3000

# Avalanche Fuji Deployer (chạy node scripts/gen-wallet.js để tạo)
DEPLOYER_KEY=
DEPLOYER_ADDRESS=
FUJI_RPC=https://api.avax-test.network/ext/bc/C/rpc

# Active Chain (tự động điền bởi scripts/deploy.js)
RPC_URL=
CHAIN_ID=
RELAYER_KEY=
AVA_TICKET_ADDRESS=
MARKETPLACE_ADDRESS=

# Email SMTP (tùy chọn — bỏ trống để chạy Dev OTP mode)
# Với Gmail: bật 2FA và tạo App Password (16 ký tự)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
