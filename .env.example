# ─── AVA-TIX Environment Variables ────────────────────────────────────────────
# Sao chép file này thành .env và điền các giá trị cần thiết

SECRET=avatix-dev-secret-doi-khi-deploy
PORT=3000

# ─── Turso Cloud Database (Render/Production) ──────────────────────────────────
# Để trống khi chạy local → tự dùng avatix.db
# Tạo tại: https://turso.tech → New Database → copy URL và token
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ─── Avalanche Fuji Deployer ──────────────────────────────────────────────────
# Tạo bằng: node scripts/gen-wallet.js
# Nạp AVAX testnet tại: https://faucet.avax.network
DEPLOYER_KEY=
DEPLOYER_ADDRESS=
FUJI_RPC=https://api.avax-test.network/ext/bc/C/rpc

# ─── Active Chain (tự động cập nhật khi chạy scripts/deploy.js) ───────────────
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
RELAYER_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
AVA_TICKET_ADDRESS=
MARKETPLACE_ADDRESS=

# ─── Email SMTP (tùy chọn — bỏ trống để chạy Dev OTP mode) ───────────────────
# Lưu ý: Render Free chặn SMTP 465/587 → dùng Resend/Brevo HTTP API hoặc Dev OTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
